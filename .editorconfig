# EditorConfig helps maintain consistent coding styles for multiple developers
# working on the same project across various editors and IDEs
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C++ source files
[*.{c,cpp,cc,cxx,h,hpp,hxx,ipp}]
indent_style = space
indent_size = 2
max_line_length = 100

# CMake files
[CMakeLists.txt]
indent_style = space
indent_size = 2

# Python files
[*.py]
indent_style = space
indent_size = 2
max_line_length = 100

# YAML configuration files
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2
end_of_line = lf

# Configuration files
[*.{config,conf,cfg}]
indent_style = space
indent_size = 2

# Makefile
[Makefile]
indent_style = tab
indent_size = 2
